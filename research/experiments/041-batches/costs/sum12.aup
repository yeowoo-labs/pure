state out = 0
input go = message {
  n: u32
}
on go {
  let total = 0
  for i in 0 .. go.n * 20 {
    let a = i + 1
    let b = a + 2
    let c = b + 3
    let d = c + 4
    let e = d + 5
    let f = e + 6
    let g = f + 7
    let h = g + 8
    let k = h + 9
    let m = k + 10
    let p = m + 11
    let q = p + 12
    total = total + 1
    let z = q
  }
  out = total
}
