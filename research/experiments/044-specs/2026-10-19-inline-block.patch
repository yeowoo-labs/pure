+/* Whether statements hold a for or a while, at any depth. */
+static bool holds_loop(const Stmt *s) {
+    for (; s; s = s->next)
+        if (s->kind == S_FOR || s->kind == S_COUNT || holds_loop(s->then) || holds_loop(s->otherwise)) return true;
