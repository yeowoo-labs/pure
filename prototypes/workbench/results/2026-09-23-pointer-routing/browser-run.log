    await page.waitForFunction(()=>window.pureWorkbench.snapshot().diagnostic.includes('작업이 바뀌'));
    check(same((await state()).states,changed.states),'a delayed restore cannot overwrite placement changes made while reading');
    // UI-only run state is deliberately not persisted.
    await page.locator('#play').click();await page.locator('#download-layout').click();
    check((await state()).diagnostic.includes('정지한 뒤'),'saving while time advances requests a stopped document');
    await page.locator('#play').click();
    // Refuse while a logical input remains held, with no lost source or partial save.
    await page.locator('#scene').focus();await page.keyboard.down('ArrowRight');
    await page.locator('#download-layout').click();
    check((await state()).diagnostic.includes('조작을 끝낸 뒤'),'saving with a held input is refused');
    await page.keyboard.up('ArrowRight');
    await page.locator('#file-input').setInputFiles(saved);
    await page.waitForFunction(()=>window.pureWorkbench.snapshot().diagnostic.includes('배치를 복원'));
    // One source edit affects every bound target, without editing input adapters.
    const edited=source.replace('t.x = clamp(t.x + 10,','t.x = clamp(t.x + 25,');
    await page.locator('#source').fill(edited);await page.locator('#apply').click();
    const beforeEdit=await state();
    await page.locator('#scene').focus();await page.keyboard.press('ArrowRight');
    check(Math.abs((await state()).states['amber.x']-(beforeEdit.states['amber.x']+25))<0.1,'editing the shared rule changes the selected amber target');
    await drag(beforeEdit.states['blue.x']+10,beforeEdit.states['blue.y']+10,beforeEdit.states['blue.x']+10,beforeEdit.states['blue.y']+10);
    const blueBefore=(await state()).states['blue.x'];await page.keyboard.press('ArrowRight');
    check(Math.abs((await state()).states['blue.x']-(blueBefore+25))<0.1,'the same single rule edit also changes the blue target');
    const lines=edited.split('\n'),items=lines.filter(line=>line.startsWith('item ')).reverse();
    const reordered=lines.map(line=>line.startsWith('item ')?items.shift():line).join('\n');
    const beforeReorder=await state();await page.locator('#source').fill(reordered);await page.locator('#apply').click();
    const afterReorder=await state();
    check(Object.entries(beforeReorder.states).every(([name,value])=>afterReorder.states[name]===value),'reordering instance declarations preserves every field by qualified name');
    await page.locator('#scene').focus();await page.keyboard.press('ArrowRight');
    check(Math.abs((await state()).states['blue.x']-(afterReorder.states['blue.x']+25))<0.1,'rebuilt parameter maps still send selection input to blue after reorder');
    // Two contacts execute the same body with different bound fields.
    await page.locator('#source').fill(source);await page.locator('#apply').click();await page.locator('#reset').click();
    await page.locator('#scene').scrollIntoViewIfNeeded();
    const session=await page.context().newCDPSession(page);
