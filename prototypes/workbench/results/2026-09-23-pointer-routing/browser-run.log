      const touch=await state();
      check(Math.abs(touch.states['green.x']-150)<0.1&&Math.abs(touch.states['blue.x']-350)<0.1&&touch.held.length===2,'simultaneous touches share code but retain independent field bindings');
      await session.send('Input.dispatchTouchEvent',{type:'touchCancel',touchPoints:[]});
      const canceled=await state();
      check(canceled.states['green.x']===80&&canceled.states['blue.x']===280&&!canceled.held.length,'shared cancel restores each contact to its own start position');

      // A real second contact on the same view must not steal its owner.
      await session.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[p1]});
      await session.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[p1,{id:2,...await client(100,140)}]});
